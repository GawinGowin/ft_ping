{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "ft_ping_make",
      "command": "make",
      "args": [
        "debug"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
        "label": "Build tool_ft_ping (cmake)",
        "type": "shell",
        "command": "cmake",
        "args": ["--build", ".", "--target", "tool_ft_ping", "--", "-j4"],
        "options": {
            "cwd": "${workspaceFolder}/build"
        },
        "group": {
            "kind": "build"
        },
        "problemMatcher": ["$gcc"]
    },
    {
      "type": "cppbuild",
      "label": "ping_make",
      "command": "make",
      "args": [
        "-C",
        "${workspaceFolder}/reference/iputils"
      ],
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "type": "cppbuild",
      "label": "poc/cmsghdr_init",
      "command": "make",
      "args": [
        "-C",
        "${workspaceFolder}/poc/cmsghdr"
      ],
    },
    {
      "type": "cppbuild",
      "label": "poc/setitimer_init",
      "command": "make",
      "args": [
        "-C",
        "${workspaceFolder}/poc/setitimer"
      ],
    },
  ],
  "version": "2.0.0"
}